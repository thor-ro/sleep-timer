# Copy this file to keystore.properties (repo root) and fill in real values.
# keystore.properties is gitignored and must NEVER be committed.
#
# storeFile may be absolute, or relative to the repo root.
storeFile=/path/to/your/release.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME

# Alternatively, leave this file out entirely and supply the same four values through the
# environment, so the passwords never touch disk:
#
#   KEYSTORE_FILE  KEYSTORE_PASSWORD  KEY_ALIAS  KEY_PASSWORD
#
# Values in keystore.properties win; the environment fills in whatever is missing. If any of
# the four cannot be resolved, the release build stays unsigned rather than falling back to
# the debug key.
